APP_NAME=Promptune AI Service
APP_ENV=local
HOST=0.0.0.0
PORT=9000

# First run: keep both mock.
NORMALIZER_PROVIDER=mock
DIAGNOSIS_PROVIDER=mock

# KcELECTRA 8-label model directory after training.
KC_MODEL_PATH=
THRESHOLD_FILE=
MAX_SEQUENCE_LENGTH=256
DEVICE=auto

# HyperCLOVA X adapter values. Leave blank until adapter contract is confirmed.
CLOVA_API_URL=
CLOVA_API_KEY=
CLOVA_MODEL=naver-hyperclovax/HyperCLOVAX-SEED-Text-Instruct-1.5B
CLOVA_TIMEOUT_SECONDS=8
